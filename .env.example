# Application
NODE_ENV=production
ANTHROPIC_MOCK=false
ANTHROPIC_API_KEY=

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=invoice_agent
MYSQL_USER=invoice
MYSQL_PASSWORD=invoicepassword
DATABASE_URL=mysql://invoice:invoicepassword@mysql:3306/invoice_agent

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=https://your-app.vercel.app,https://yourdomain.com

# Web
VITE_API_URL=http://<ec2-public-ip>:3001
WEB_PORT=5173

# AWS S3
AWS_REGION=eu-north-1
S3_BUCKET=invoice-agent
# Prefer instance IAM role on EC2; omit static keys when possible.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
