# Application
NODE_ENV=development
ANTHROPIC_MOCK=true
ANTHROPIC_API_KEY=

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=invoice_agent
MYSQL_USER=invoice
MYSQL_PASSWORD=invoicepassword
# Local npm processes: 127.0.0.1. Docker Compose service hostname is mysql.
DATABASE_URL=mysql://invoice:invoicepassword@127.0.0.1:3306/invoice_agent

# API
API_PORT=3001
API_HOST=0.0.0.0
# Comma-separated browser origins allowed to call the API.
# Local Vite: http://localhost:5173
# Vercel + AWS API: https://your-app.vercel.app,https://yourdomain.com
CORS_ORIGIN=http://localhost:5173

# Web
# API origin only (no trailing slash). Paths already start with /api.
# Local Vite: leave empty (proxy /api → :3001).
# Vercel: http://<ec2-public-ip>:3001
VITE_API_URL=
WEB_PORT=5173

# AWS S3 (private bucket; API issues short-lived presigned GET URLs)
# EC2: prefer the instance IAM role (omit static keys).
# Local: env keys, AWS_PROFILE, or ~/.aws/credentials.
AWS_REGION=eu-north-1
S3_BUCKET=invoice-agent
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=

# Production (EC2) — set in /opt/invoice-agent/.env
# NODE_ENV=production
# ANTHROPIC_MOCK=false
# IMAGE_TAG / GHCR_OWNER are set by the deploy workflow
