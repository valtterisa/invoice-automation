# Application
NODE_ENV=production
ANTHROPIC_API_KEY=

# Managed MySQL (RDS / Aurora / etc.)
DATABASE_URL=mysql://USER:PASSWORD@YOUR_RDS_HOST:3306/invoice_agent

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=https://your-app.vercel.app,https://yourdomain.com
IDEMPOTENCY_TTL_SECONDS=86400

# Web
VITE_API_URL=http://<ec2-public-ip>:3001
WEB_PORT=5173

# AWS S3
AWS_REGION=eu-north-1
S3_BUCKET=invoice-agent
# Prefer instance IAM role on EC2; omit static keys when possible.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
